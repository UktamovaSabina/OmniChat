# Copy this file to .env. Everything is optional: with no .env, Unified AI runs in mock (demo) mode.

# "mock" (default): no network calls; classifier, answers and judge are simulated locally.
# "openrouter": real models through OpenRouter. Needs OPENROUTER_API_KEY; without one the server warns and uses mock.
UNIFIED_AI_MODE=mock

# Only needed when UNIFIED_AI_MODE=openrouter. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: the small, fast model that classifies prompts and judges answers in openrouter mode.
# UNIFIED_AI_ROUTER_MODEL=google/gemini-2.5-flash

# Optional: API server port (the Angular dev server proxies /api here).
# PORT=3000
